# ============================================================
# fire-safety-rag / backend 环境变量模板
# 用法： cp .env.example .env   然后按注释填值
# 说明： 所有变量都能在 app/config.py 的 Settings 中找到同名（小写）字段
# ============================================================

# ---------- 运行环境 ----------
APP_NAME=fire-safety-rag
ENVIRONMENT=dev                     # dev | staging | prod
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------- DeepSeek（LLM）----------
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1024

# ---------- Embedding ----------
# local = 本地 HuggingFace 加载（免费、慢、吃内存）；siliconflow = 走 API（快、省内存）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# auto = 有可用 CUDA 就用显卡，否则 CPU；也可写死 cpu / cuda / cuda:0
# ⚠️ 装了 CPU 版 torch（版本号带 +cpu）时，auto 也会退回 CPU：
#    pip install torch --index-url https://download.pytorch.org/whl/cu128
EMBEDDING_DEVICE=auto
# GPU 上可调到 64~128 提升吞吐；CPU 上 16 即可
EMBEDDING_BATCH_SIZE=16
# SiliconFlow 兼容 OpenAI 接口（EMBEDDING_PROVIDER=siliconflow 时必填）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Rerank ----------
RERANK_PROVIDER=local               # local = bge-reranker-v2-m3 本地 | none = 关闭精排
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5
# fp16 只在 GPU 上有意义（CPU 上更慢）；最终取「本值 or 是否检测到 CUDA」
RERANK_USE_FP16=false

# ---------- 数据库（Neon PostgreSQL + pgvector）----------
# ⚠️ 必须使用 Neon 的 **pooler** 连接串（主机名含 -pooler），并带 sslmode=require
# 例：postgresql://user:pwd@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_ECHO=false
DB_POOL_SIZE=5

# ---------- Redis 语义缓存（第二批；留空则自动降级为内存 LRU）----------
REDIS_URL=
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95       # 余弦相似度阈值，>= 该值直接命中
SEMANTIC_CACHE_TTL=86400            # 秒

# ---------- 检索参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=10                   # 召回条数（融合前）
RERANK_TOP_K=5                      # 精排后送入 LLM 的条数
SIMILARITY_TOP_K=10
BM25_TOP_K=10
ENABLE_QUERY_TRANSFORM=true
ENABLE_HYDE=false                   # HyDE 多花一次 LLM 调用，按需开
ENABLE_HYPE=true                    # 建库时为 chunk 生成假想问题
ENABLE_CHUNK_FILTER=true            # 入库前丢弃封面/目次/前言/参考文献等低信息密度段落

# ---------- 会话记忆 ----------
SESSION_BACKEND=postgres           # postgres | redis
SESSION_MAX_TURNS=6                 # 拼进 prompt 的历史轮数

# ---------- 上传 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ---------- 解析质量 ----------
# PDF 文字层质量分低于该值即判定为"乱码"（方正书版等国标 PDF 常见），
# 改用 PyMuPDF 重抽或降级 OCR。正常中文 0.9~1.0；乱码 < 0.01
MIN_TEXT_QUALITY=0.15
# PaddleOCR 3.x 的文字行方向模型（PP-LCNet_x1_0_textline_ori）在国内常下载失败，
# 正立印刷件不需要它，默认关闭；倒置/竖排扫描件再改成 true
OCR_TEXTLINE_ORIENTATION=false

# ---------- 模型缓存目录 ----------
# ⚠️ 变量名故意不叫 HF_HOME：环境变量优先级高于 .env，机器上若把 HF_HOME 设成
#    盘符根目录下的不可写路径，会连带把模型下载和 embedding 加载一起带崩。
#    本项由 app/config.py 在导入时转成 HF_HOME/HF_HUB_CACHE/LLAMA_INDEX_CACHE_DIR，
#    并做真实写测试；不可写会自动跳到下一个候选（项目内 -> 系统临时目录）。
MODEL_CACHE_DIR=./data/indexes/hf_cache

# ---------- 跨域（Vercel 前端域名）----------
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ---------- 管理接口口令（/api/admin/*）----------
# 生成方法：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 请求时放在请求头： X-Admin-Token: <值>
ADMIN_TOKEN=change-me

# ---------- LangFuse 可观测性（第二批）----------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
