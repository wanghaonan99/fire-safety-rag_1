# ============================================================================
# 生产环境变量模板 —— 复制为仓库根目录的 .env.prod 后填写
#   cp deploy/.env.prod.example .env.prod
# ⚠️ .env.prod 已在 .gitignore 里（确认一下），绝不要提交到仓库
# ============================================================================

# ---------- 基础 ----------
APP_NAME=工厂消防知识问答助手
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO

# ---------- LLM（必填）----------
DEEPSEEK_API_KEY=sk-请填入你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1200

# ---------- 向量化 ----------
# 档 A1（服务器 ≥8GB 内存，质量优先）：local + 挂载模型缓存
# 档 A2（服务器 4GB 内存，省 2.2GB）：siliconflow，需下面的 key
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu            # 云服务器一般没有 GPU；有 GPU 才改 cuda
EMBEDDING_BATCH_SIZE=8          # CPU 上别开太大，16 容易把内存打满

# 档 A2 才需要（EMBEDDING_PROVIDER=siliconflow）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 精排 ----------
# local = 本地 bge-reranker-v2-m3（再吃 2.3GB 内存，但 MRR 明显更好）
# none  = 关闭精排（省内存，检索质量下降，适合 4GB 机器）
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=10
RERANK_TOP_K=5
RERANK_USE_FP16=false

# ---------- 数据库 ----------
# ⚠️ compose 会用 PG 密码覆盖这一行；只有连外部库（如 Neon）时才需要改这里
DATABASE_URL=postgresql://fsrag:CHANGE_ME@db:5432/fsrag
DB_POOL_SIZE=5
DB_ECHO=false

# ---------- 缓存 ----------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL=86400
# 留空 = 用进程内 LRU；填了才用 Redis
REDIS_URL=

# ---------- 检索 & 入库 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=10
SIMILARITY_TOP_K=10
ENABLE_HYPE=true                # 入库时每块一次 LLM 调用，是导入慢的主因
ENABLE_CHUNK_FILTER=true
ENABLE_QUERY_TRANSFORM=false
ENABLE_HYDE=false
MIN_TEXT_QUALITY=0.15
MAX_UPLOAD_MB=50

# ---------- 会话 ----------
SESSION_BACKEND=postgres
SESSION_MAX_TURNS=6

# ---------- 路径（容器内，compose 已覆盖，保持默认即可）----------
MODEL_CACHE_DIR=/app/data/indexes/hf_cache
UPLOAD_DIR=/app/data/uploads

# ---------- 安全（必改！）----------
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=请替换为随机串

# 允许的前端来源（逗号分隔，不要带结尾斜杠）
CORS_ORIGINS=https://你的前端域名.vercel.app,http://localhost:3000

# ---------- 可观测（可选）----------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
